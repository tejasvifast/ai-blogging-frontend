# ─────────────────────────────────────────────────────────────
#  Backend API
#  NOTE: the backend mounts routers at ROOT — there is NO /api/v1 prefix.
#  (verified against ../ai-blogging-backend/src/app.ts)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side calls (SSR/ISR fetch, revalidate) may use an internal URL if different:
API_INTERNAL_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────
#  Auth.js (NextAuth v5)
# ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-long-random-secret
# NextAuth v5 reads AUTH_URL; NEXTAUTH_URL kept for compatibility.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Trust the host header (needed on Vercel / behind proxies)
AUTH_TRUST_HOST=true

# ─────────────────────────────────────────────────────────────
#  Google OAuth (MUST be the SAME client as the backend, so the
#  id_token audience matches GOOGLE_CLIENT_ID on /auth/google)
# ─────────────────────────────────────────────────────────────
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret

# ─────────────────────────────────────────────────────────────
#  Revalidation webhook — MUST match backend REVALIDATE_SECRET.
#  Backend POSTs ${FRONTEND_URL}/api/revalidate with header
#  x-revalidate-secret on every post create/update/delete/publish.
# ─────────────────────────────────────────────────────────────
REVALIDATE_SECRET=change-me-generate-a-long-random-secret

# ─────────────────────────────────────────────────────────────
#  Site metadata (SEO / OG / sitemap)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=YourBlog
NEXT_PUBLIC_SITE_DESCRIPTION=Fresh, AI-curated writing on the things that matter.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# ─────────────────────────────────────────────────────────────
#  Analytics & Ads (leave blank to disable)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=
